{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicHome",
  "version": "0.1.0",
  "identifier": "com.pichome.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:14567",
    "beforeBuildCommand": "bash build_backend.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PicHome",
        "width": 1200,
        "height": 800,
        "visible": false,
        "url": "http://127.0.0.1:14567"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/pichome-server": "pichome-server"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "../entitlements.plist"
    }
  }
}
