# Python
__pycache__/
*.py[cod]
*.sqlite3

# 虚拟环境
.venv/
venv/

# 本地上传 / 回收站文件（实际图片，不入库）
media/

# 收集静态文件
static_collected/

# 环境变量（含密钥，切勿提交）
.env

# 编辑器
.idea/
.vscode/
.DS_Store
# WorkBuddy 本地数据（记忆 / 自动化日志）不入库，
# 但项目级 skill 属于交付物，需要随仓库分发，所以单独放行。
.workbuddy/*
!.workbuddy/skills/

db_data
media_data

# 服务器部署演示 demo 隐藏，避免暴露服务器信息
DEPLOY.md

# PyInstaller 构建产物（desktop/build.spec 是交付物，需保留）
build/
dist/

# Tauri 桌面端构建产物（源码与配置入库，编译产物与打包二进制不入库）
desktop/src-tauri/target/
desktop/src-tauri/bin/
desktop/src-tauri/gen/
desktop/node_modules/