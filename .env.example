# ===== 图床配置说明 =====
# picHome 支持多图床（七牛云 Kodo / 阿里云 OSS / 腾讯云 COS / GitHub），
# 密钥推荐在网页上配置（齿轮图标 → 图床设置），会存进数据库，无需改这个文件。
#
# 下面这组 QINIU_* 只用于「首次启动自动播种一条启用中的七牛云配置」（initstorage 命令），
# 播种后以页面上的配置为准。不用七牛云的话可以整段留空 / 删掉。

# ===== 七牛云对象存储（可选，仅用于首次播种）=====
# 在 https://portal.qiniu.com 控制台 -> 个人中心 -> 密钥管理 获取 AK / SK
QINIU_ACCESS_KEY=你的AccessKey
QINIU_SECRET_KEY=你的SecretKey

# 存储桶名称（空间名）
QINIU_BUCKET=你的bucket名称

# 存储桶绑定的访问域名（CDN 或 测试域名），例如 https://cdn.example.com
# 注意：结尾不要带斜杠
QINIU_DOMAIN=https://你的域名

# 列表缩略图用的七牛云处理样式（可选，留空则用原图）
# 写法一（处理参数）：?imageView2/2/w/400/q/75
# 写法二（空间里预置的样式名）：-thumb
QINIU_THUMB_STYLE=?imageView2/2/w/400/q/75

# ===== 对外 API / 命令行（pichome CLI、AI Agent）=====
# /api/v1/upload 的访问令牌。
# 留空 = 不校验，匿名即可上传（仅建议本机 / 内网自用）；
# 公网暴露时务必填一串随机字符，CLI 侧用 --token 或同名环境变量传入。
PICHOME_API_TOKEN=

# CLI 默认访问的服务地址（docker compose 默认映射 28080；本地 runserver 用 8000）
PICHOME_API_URL=http://127.0.0.1:28080

# ===== Django 基础配置（可选）=====
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=请随便改成一串随机字符
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 数据库文件路径（容器里指向持久化卷，本地一般不用改）
# DJANGO_DB_PATH=/app/data/db.sqlite3
